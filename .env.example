# ============================================
# Modo 1: AI Studio (Pesquisa Web com API Key)
# ============================================
# Gere sua chave em https://aistudio.google.com/app/apikey
# Quando GOOGLE_API_KEY estiver preenchida, o agente usa AI Studio e busca web.
GOOGLE_API_KEY=YOUR_AI_STUDIO_API_KEY_HERE
# Definida automaticamente pelo config.py ("False" com GOOGLE_API_KEY, "True" com Vertex AI).
GOOGLE_GENAI_USE_VERTEXAI=False
MODEL_NAME=gemini-3.5-flash

# ============================================
# Modo 2: Vertex AI (Corporativo + Datastores)
# ============================================
# Para usar Vertex AI localmente via ADC (gcloud auth application-default login),
# remova/comente GOOGLE_API_KEY acima e preencha as variáveis abaixo.
GOOGLE_CLOUD_PROJECT=<SEU_PROJECT_ID_GCP>
GOOGLE_CLOUD_LOCATION=global

# Opcional: Deploy no Vertex AI Agent Engine (app/deploy.py)
DEPLOY_LOCATION=us-west1
STAGING_BUCKET=gs://<SEU_BUCKET_STAGING>

# ============================================
# Datastores Corporativos (Vertex AI Search)
# ============================================
# Preencha apenas quando estiver usando Vertex AI com acesso aos datastores.
# Formato: projects/<PROJECT_NUMBER>/locations/global/collections/default_collection/dataStores/<DATA_STORE_ID>
DATA_STORE_DATASEBRAE=
DATA_STORE_PORTFOLIO=
DATA_STORE_SHAREPOINT=
DATA_STORE_ONEDRIVE=
